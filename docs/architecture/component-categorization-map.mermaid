    %% Styling
    classDef category fill:#2196F3,stroke:#1565C0,stroke-width:2px,color:#fff,font-weight:bold
    classDef component fill:#E3F2FD,stroke:#1565C0,stroke-width:1px,color:#000
    classDef root fill:#607D8B,stroke:#263238,stroke-width:3px,color:#fff,font-weight:bold
    classDef errorBoundary fill:#FF5722,stroke:#BF360C,stroke-width:2px,color:#fff

    class Root root
    class UI,Feedback,Modals,Layout,Game category
    class UI1,UI2,UI3,UI4,UI5,UI6,UI7 component
    class FB1,FB2,FB3,FB4,FB5,FB6,FB7 component
    class MD1,MD2,MD3 component
    class LY1,LY2,LY3,LY4,LY5,LY6,LY7,LY8,LY9,LY10 component
    class GM1,GM2,GM3,GM4,GM5,GM6,GM7,GM8 component
    class EB,EB1,EB2,EB3,EB4 errorBoundary
