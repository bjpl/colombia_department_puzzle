{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/main.tsx",
    "./src/App.tsx",
    "./src/components/GameContainer.tsx",
    "./src/components/OptimizedColombiaMap.tsx",
    "./src/components/DepartmentTray.tsx",
    "./src/components/StudyMode.tsx",
    "./src/context/GameContext.tsx",
    "./src/context/AccessibilityContext.tsx",
    "./src/hooks/useKeyboardNavigation.ts",
    "./src/hooks/useMediaQuery.ts",
    "./src/hooks/usePWA.ts",
    "./src/hooks/useStudyMode.ts",
    "./src/services/storage.ts",
    "./src/services/soundManager.ts",
    "./src/data/colombiaDepartments.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "./docs/api",
  "exclude": [
    "**/*+(.test|.spec).+(ts|tsx|js)",
    "**/tests/**/*",
    "**/node_modules/**",
    "**/*.d.ts"
  ],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "readme": "none",
  "plugin": [],
  "theme": "default",
  "name": "Colombia Departments Puzzle - API Documentation",
  "includeVersion": true,
  "categorizeByGroup": true,
  "defaultCategory": "Components",
  "categoryOrder": [
    "Components",
    "Hooks",
    "Context",
    "Services",
    "Data",
    "Utils",
    "Types",
    "*"
  ],
  "sort": ["source-order"],
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "githubPages": false,
  "hideGenerator": false,
  "skipErrorChecking": true
}
