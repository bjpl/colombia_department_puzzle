# Colombia Departments Puzzle - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# GOOGLE ANALYTICS 4
# ============================================
# Get your Measurement ID from: https://analytics.google.com
# Admin → Data Streams → Web → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_ENABLED=true

# ============================================
# SENTRY ERROR TRACKING
# ============================================
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
VITE_SENTRY_ENABLED=true
VITE_SENTRY_ENVIRONMENT=production

# Performance monitoring - fraction of transactions to send (0.0 to 1.0)
# 0.1 = 10% of transactions
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay sampling rates
# Session sample rate: % of normal sessions to record (0.1 = 10%)
# On error sample rate: % of sessions with errors to record (1.0 = 100%)
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ============================================
# SENTRY BUILD CONFIGURATION (CI/CD)
# ============================================
# Required for uploading source maps during build
# Get auth token from: https://sentry.io → Settings → Auth Tokens
SENTRY_ORG=your-org-name
SENTRY_PROJECT=colombia-departments-puzzle
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
VITE_APP_VERSION=1.0.0
VITE_DEPLOY_ENV=production
VITE_BASE_URL=https://colombia-puzzle.vercel.app

# ============================================
# SUPABASE AUTHENTICATION
# ============================================
# Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Project Settings → API → Project API keys → anon/public key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Feature flag to enable/disable Supabase authentication
# Set to 'true' to enable Google OAuth, email auth, and magic links
VITE_ENABLE_SUPABASE_AUTH=false

# ============================================
# GOOGLE OAUTH SETUP (via Supabase)
# ============================================
# Google OAuth is configured in the Supabase Dashboard, NOT here.
# Steps:
# 1. Go to Google Cloud Console: https://console.cloud.google.com
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI:
#    https://YOUR-PROJECT-ID.supabase.co/auth/v1/callback
# 4. Copy Client ID and Client Secret
# 5. In Supabase Dashboard → Authentication → Providers → Google:
#    - Enable Google provider
#    - Paste Client ID and Client Secret
# 6. Set VITE_ENABLE_SUPABASE_AUTH=true above
#
# Redirect URLs to configure in Supabase Dashboard:
# - Site URL: https://your-domain.com/colombia_department_puzzle
# - Redirect URLs:
#   https://your-domain.com/colombia_department_puzzle/auth/callback
#   http://localhost:3000/colombia_department_puzzle/auth/callback

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features for different environments
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# ============================================
# BUILD CONFIGURATION
# ============================================
NODE_ENV=production

# Vercel sets this automatically - included for reference
# VERCEL=1
