{
  "name": "colombia-departments-puzzle",
  "version": "1.0.0",
  "description": "An educational puzzle game to learn Colombian departments through drag-and-drop interaction",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test -- --run && npm run test:e2e",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjpl/colombia_department_puzzle.git"
  },
  "keywords": [
    "colombia",
    "geography",
    "education",
    "puzzle",
    "game",
    "interactive"
  ],
  "author": "BJPL",
  "license": "MIT",
  "homepage": "https://bjpl.github.io/colombia_department_puzzle",
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.0",
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.5.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "gh-pages": "^6.3.0",
    "idb": "^8.0.3",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^1.0.4",
    "workbox-window": "^7.3.0"
  }
}
