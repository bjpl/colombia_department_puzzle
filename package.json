{
  "name": "colombia-departments-puzzle",
  "version": "1.0.0",
  "description": "An educational puzzle game to learn Colombian departments through drag-and-drop interaction",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/optimize-build.js",
    "build:analyze": "vite build && node scripts/optimize-build.js && du -sh dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test -- --run && npm run test:e2e",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test -- --run",
    "docs:api": "typedoc",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjpl/colombia_department_puzzle.git"
  },
  "keywords": [
    "colombia",
    "geography",
    "education",
    "puzzle",
    "game",
    "interactive"
  ],
  "author": "BJPL",
  "license": "MIT",
  "homepage": "https://bjpl.github.io/colombia_department_puzzle",
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@supabase/supabase-js": "^2.75.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.0",
    "esbuild": "^0.25.12",
    "lucide-react": "0.545.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.9.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "24.7.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.3.0",
    "idb": "^8.0.3",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "3.4.18",
    "typedoc": "0.28.14",
    "typescript": "5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "3.2.4",
    "workbox-window": "^7.3.0"
  }
}
